# ==============================================================================
# Analyser Backend - Environment Configuration Template
# Copy this file to .env and adjust variables as per your local/deployment environment.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analyser_db

# Security & JWT Authentication
# IMPORTANT: Generate a strong, random 256-bit key in production using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters_long

# JWT Cryptographic Algorithm (Default: HS256)
ALGORITHM=HS256

# JWT Access Token Expiry Duration in Minutes (Default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vector Database (ChromaDB) Persistence Directory
# Directory where local vector collections and embeddings will be stored
CHROMA_PERSIST_DIR=./data/chroma

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/) for RAG embeddings & circular synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key
# Obtain from Groq Console (https://console.groq.com/) for ultra-fast LLaMA-3.1-8B inference
GROQ_API_KEY=your_groq_api_key_here

# Initial Root SuperAdmin Provisioning Credentials
# Used by seed.py for initial system provisioning (change immediately in production!)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=admin123

